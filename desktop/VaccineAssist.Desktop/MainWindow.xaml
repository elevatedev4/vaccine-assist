<Window x:Class="VaccineAssist.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine Assist"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right"
                    Background="#F2F2F2" Margin="0,0,0,0">
            <Button x:Name="LogoutButton" Content="Sign out" Height="32" Padding="12,0"
                    Margin="0,6,10,6" Click="LogoutButton_OnClick"/>
        </StackPanel>

        <TabControl x:Name="MainTabs">
            <TabItem Header="Scheduling">
                <ContentControl x:Name="SchedulingContent"/>
            </TabItem>
            <TabItem Header="Data entry">
                <ContentControl x:Name="DataEntryTabContent"/>
            </TabItem>
            <TabItem Header="Lots">
                <ContentControl x:Name="LotsContent"/>
            </TabItem>
            <TabItem Header="Active vaccines">
                <Grid>
                    <TextBlock Text="Active vaccines — a live view of which vaccines you currently have in stock will go here."
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="Gray" FontSize="14" Width="420"/>
                </Grid>
            </TabItem>
            <TabItem Header="Ordering">
                <Grid>
                    <TextBlock Text="Ordering — vaccine ordering and reorder tracking will go here."
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="Gray" FontSize="14" Width="420"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
