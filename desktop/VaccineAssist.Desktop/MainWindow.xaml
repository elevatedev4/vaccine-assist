<Window x:Class="VaccineAssist.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine Assist"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="140" Background="#F2F2F2">
            <Button x:Name="VaccinesButton" Content="Vaccines" Height="40" Click="VaccinesButton_OnClick"/>
            <Button x:Name="LotsButton" Content="Lots" Height="40" Click="LotsButton_OnClick"/>
            <Button x:Name="EntryButton" Content="Entry" Height="40" Click="EntryButton_OnClick"/>
            <Button x:Name="LogoutButton" Content="Sign out" Height="40" Margin="0,80,0,0" Click="LogoutButton_OnClick"/>
        </StackPanel>
        <ContentControl x:Name="MainContent"/>
    </DockPanel>
</Window>
