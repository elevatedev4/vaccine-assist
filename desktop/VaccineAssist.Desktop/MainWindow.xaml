<Window x:Class="VaccineAssist.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine Assist"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right"
                    Background="#F2F2F2" Margin="0,0,0,0">
            <Button x:Name="LogoutButton" Content="Sign out" Height="32" Padding="12,0"
                    Margin="0,6,10,6" Click="LogoutButton_OnClick"/>
        </StackPanel>

        <!--
            Will, 2026-09-13: "Make sure data entry page is the main page
            that is shown" — DataEntryTabItem below sets IsSelected="True"
            explicitly (TabControl would otherwise default to the first
            tab, Scheduling).

            Scheduling/Lots/Active vaccines/Ordering/Physicians each host a
            CloudPageView (a WebView2 view of the matching cloud-app page —
            see that control's own doc comment) instead of the old native
            view, for cloud-parity ("All the features that are in the cloud
            version should be in the desktop version"). MainWindow.xaml.cs
            builds each one LAZILY, the first time its tab is actually
            selected (via MainTabs.SelectionChanged), rather than all five
            up front — staff who "just run it and minimize it immediately"
            per the brief should never pay for five WebView2 browser
            processes they never look at.
        -->
        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_OnSelectionChanged">
            <TabItem x:Name="SchedulingTabItem" Header="Scheduling">
                <ContentControl x:Name="SchedulingContent"/>
            </TabItem>
            <TabItem x:Name="DataEntryTabItem" Header="Data entry" IsSelected="True">
                <ContentControl x:Name="DataEntryTabContent"/>
            </TabItem>
            <TabItem x:Name="LotsTabItem" Header="Lots">
                <ContentControl x:Name="LotsContent"/>
            </TabItem>
            <TabItem x:Name="ActiveVaccinesTabItem" Header="Active vaccines">
                <ContentControl x:Name="ActiveVaccinesContent"/>
            </TabItem>
            <TabItem x:Name="OrderingTabItem" Header="Ordering">
                <ContentControl x:Name="OrderingContent"/>
            </TabItem>
            <TabItem x:Name="PhysiciansTabItem" Header="Physicians">
                <ContentControl x:Name="PhysiciansContent"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
