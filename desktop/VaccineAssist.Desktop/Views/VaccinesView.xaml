<UserControl x:Class="VaccineAssist.Desktop.Views.VaccinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="VaccinesView_OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Active vaccines" FontSize="18" FontWeight="Bold"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Refresh" Command="{Binding LoadCommand}" Padding="8,2"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- IsReadOnly="False" at the grid level so the Active column's
             checkbox is genuinely editable; every other column is marked
             IsReadOnly="True" individually so only Active can be changed.
             CanUserAddRows/CanUserDeleteRows are off — this grid edits an
             existing row's Active flag only, it never creates or removes
             vaccine rows. -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Vaccines}" AutoGenerateColumns="False"
                  IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Short code" Binding="{Binding ShortCode}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Dose" Binding="{Binding Dose}" Width="0.5*" IsReadOnly="True"/>
                <DataGridTextColumn Header="NDC" Binding="{Binding Ndc}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cash price" Binding="{Binding CashPriceDisplay}" Width="*" IsReadOnly="True"/>
                <!-- Mode=OneWay is required here: DataGridCheckBoxColumn always
                     renders its cell with a live CheckBox (unlike text columns,
                     which fall back to a plain TextBlock when read-only), and
                     CheckBox.IsChecked defaults to a TwoWay binding mode
                     regardless of the column's own IsReadOnly="True". Since
                     HasActiveLot is get-only, WPF throws InvalidOperationException
                     while generating the cell unless the mode is pinned to OneWay. -->
                <DataGridCheckBoxColumn Header="Current lot" Binding="{Binding HasActiveLot, Mode=OneWay}" Width="0.6*" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active, Mode=TwoWay}" Width="0.5*" IsReadOnly="False"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
