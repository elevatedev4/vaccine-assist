<Window x:Class="VaccineAssist.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine Assist — Sign in"
        Width="380" MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <!--
        Will, 2026-09-14 (verbatim): "the layout is poor ... the data entry
        lines are sized poorly" — the email TextBox/password PasswordBox
        were rendering only a few pixels tall (text cut off) because
        neither had an explicit height or padding, and the fixed
        Width="380" Height="308" window meant the whole form was cramped.
        Fix: MinHeight+Padding on both fields so text is never clipped,
        each label sits directly above its field with a small 4px gap,
        12px between rows, and SizeToContent="Height" (with MinWidth
        keeping the window from ever going narrower than before) so the
        window always fits its content instead of a hardcoded guess.
        Behavior (bindings, click handler, hint text) is unchanged.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vaccine Assist" FontSize="20" FontWeight="Bold"/>

        <TextBlock Grid.Row="2" Text="Shared pharmacy email"/>
        <TextBox Grid.Row="4" x:Name="EmailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="28" Padding="6,4" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" Text="Password"/>
        <PasswordBox Grid.Row="8" x:Name="PasswordInput"
                      MinHeight="28" Padding="6,4" VerticalContentAlignment="Center"/>

        <Button Grid.Row="10" x:Name="SignInButton" Content="Sign in" Height="32"
                Click="SignInButton_OnClick"/>

        <TextBlock Grid.Row="12" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="14" Text="No Supabase project yet? Set SupabaseUrl/SupabaseAnonKey in %AppData%\VaccineAssist\settings.json."
                    TextWrapping="Wrap" FontSize="10" Foreground="Gray"/>
    </Grid>
</Window>
