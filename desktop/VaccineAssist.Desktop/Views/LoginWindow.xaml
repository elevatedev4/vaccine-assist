<Window x:Class="VaccineAssist.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:VaccineAssist.Desktop.Common"
        Title="Vaccine Assist — Sign in"
        Width="380" MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <!--
        Will, 2026-09-14 (verbatim): "the layout is poor ... the data entry
        lines are sized poorly" — the email TextBox/password PasswordBox
        were rendering only a few pixels tall (text cut off) because
        neither had an explicit height or padding, and the fixed
        Width="380" Height="308" window meant the whole form was cramped.
        Fix: MinHeight+Padding on both fields so text is never clipped,
        each label sits directly above its field with a small 4px gap,
        12px between rows, and SizeToContent="Height" (with MinWidth
        keeping the window from ever going narrower than before) so the
        window always fits its content instead of a hardcoded guess.
        Behavior (bindings, click handler, hint text) is unchanged.

        BUSY/SPINNER FIX (Will, 2026-09-16, verbatim): "It needs to lock
        the signin button with a spinner in it to show it's trying" — the
        email/password fields are now disabled (InverseBooleanConverter)
        and the button's content swaps from "Sign in" to an indeterminate
        ProgressBar (BooleanToVisibilityConverter/InverseBooleanToVisibilityConverter)
        while LoginViewModel.IsBusy is true. IsBusy now stays true for the
        WHOLE sign-in + cloud-handoff flow (see LoginViewModel.SetBusy's
        doc comment), not just the raw auth call, so the spinner is an
        honest signal the whole time — this is half of the "sign in does
        nothing" fix; see App.xaml.cs and CloudPageView.EnsureInitializedAsync
        for the other half (the actual hang this was masking).
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <common:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vaccine Assist" FontSize="20" FontWeight="Bold"/>

        <TextBlock Grid.Row="2" Text="Shared pharmacy email"/>
        <TextBox Grid.Row="4" x:Name="EmailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                  MinHeight="28" Padding="6,4" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" Text="Password"/>
        <PasswordBox Grid.Row="8" x:Name="PasswordInput"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                      MinHeight="28" Padding="6,4" VerticalContentAlignment="Center"/>

        <Button Grid.Row="10" x:Name="SignInButton" Height="32"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                Click="SignInButton_OnClick">
            <Grid>
                <TextBlock Text="Sign in" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <ProgressBar IsIndeterminate="True" Width="70" Height="6"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Button>

        <TextBlock Grid.Row="12" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="14" Text="No Supabase project yet? Set SupabaseUrl/SupabaseAnonKey in %AppData%\VaccineAssist\settings.json."
                    TextWrapping="Wrap" FontSize="10" Foreground="Gray"/>
    </Grid>
</Window>
