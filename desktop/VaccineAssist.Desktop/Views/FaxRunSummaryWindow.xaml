<Window x:Class="VaccineAssist.Desktop.Views.FaxRunSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine Assist — Fax run summary"
        Width="960" Height="620"
        MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <!--
        Will's brief: "show FaxRunSummaryWindow (counts: imported rows,
        patients, sent, in-process, failed, needs-fax-number, with a
        per-row grid)." Failed rows get a Retry button (ViewModels/
        FaxRunSummaryViewModel.cs's RetryCommand — CanExecute only for
        Status == "Failed", so it's the ONLY way a retry ever happens —
        explicit click, never automatic).

        2026-09-25 (Will's screen-widths brief): widened from 720x560 to
        960x620 — the grid's 3*-weighted Error column (free-text failure
        reasons) was cramped at 720. Constructor (FaxRunSummaryWindow.xaml.cs)
        clamps this down to the monitor's work area minus 40px, same
        convention as Views/MacroCodesWindow.xaml.cs, via
        Common/WindowSizing.cs.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Fax run summary" FontSize="18" FontWeight="Bold"/>

        <WrapPanel Grid.Row="2">
            <TextBlock Text="{Binding Summary.RowsImported, StringFormat='Rows imported: {0}'}" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding Summary.PatientsProcessed, StringFormat='Patients: {0}'}" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding Summary.Sent, StringFormat='Sent: {0}'}" Margin="0,0,16,0" Foreground="Green"/>
            <TextBlock Text="{Binding Summary.InProcess, StringFormat='In process: {0}'}" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding Summary.Failed, StringFormat='Failed: {0}'}" Margin="0,0,16,0" Foreground="Red"/>
            <TextBlock Text="{Binding Summary.NeedsFaxNumber, StringFormat='Needs fax number: {0}'}" Margin="0,0,16,0" Foreground="DarkOrange"/>
        </WrapPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Patient" Binding="{Binding PatientInitials}" Width="*"/>
                <DataGridTextColumn Header="Prescriber" Binding="{Binding PrescriberName}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="3*"/>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Retry" Padding="6,1"
                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" Foreground="DarkSlateGray"/>
    </Grid>
</Window>
