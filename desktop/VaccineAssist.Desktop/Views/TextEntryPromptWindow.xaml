<Window x:Class="VaccineAssist.Desktop.Views.TextEntryPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Value needed"
        Width="380" SizeToContent="Height"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Loaded="TextEntryPromptWindow_OnLoaded">
    <!--
        V-..., 2026-09-10 (Will, 2026-09-09/10: desktop data entry "made it
        through to quantity (slowly) and stopped at quantity (not
        entered)" — every vaccine row currently has a blank Quantity/
        Directions on file, and the old behavior silently skipped typing
        anything for either instead of asking). InputQuantityStep/
        InputDirectionsStep show this instead. Same popup-focus mechanics
        as VarUpdateConfirmationWindow: owned by the data-entry popup
        window, ShowDialog (modal, so it comes to the front over PioneerRx
        without needing its own SetForegroundWindow dance — the data-entry
        popup is already the foreground/Topmost window by the time "Enter
        into Pioneer" runs this sequence). Continue types the entered
        value into Pioneer and saves it back onto the vaccine catalog
        record; Cancel aborts the whole entry; Skip (Directions only — see
        allowSkip) leaves Pioneer's field untouched, for a workflow that
        fills SIG later. See ViewModels/DataEntryPopupViewModel's
        RequestTextPromptRequested and
        PioneerEntryAutomation/Sequencing/TextPromptResult.cs.
    -->
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap"/>
        <TextBox x:Name="ValueTextBox" Margin="0,12,0,0" KeyDown="ValueTextBox_OnKeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="Skip" Padding="12,4" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="SkipButton_OnClick"/>
            <Button x:Name="ContinueButton" Content="Continue" Padding="12,4" Margin="0,0,8,0"
                    IsDefault="True" Click="ContinueButton_OnClick"/>
            <Button Content="Cancel" Padding="12,4" IsCancel="True" Click="CancelButton_OnClick"/>
        </StackPanel>
    </StackPanel>
</Window>
