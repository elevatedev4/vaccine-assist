<UserControl x:Class="VaccineAssist.Desktop.Views.CloudPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <!--
        V-T-single-nav (Will, 2026-09-14: "all the tabs in the app match
        exactly what is in the cloud ... remove that extra row of tabs"):
        MainWindow now hosts exactly ONE instance of this control,
        full-window, loading the cloud app's root ("/") — the cloud app's
        OWN top nav is the only tab row. See CloudPageView.xaml.cs's own
        doc comment for the Part 1 (session-handoff) lifecycle change.
        Shares ONE CoreWebView2Environment/user-data folder with the
        macro-codes popup (Services/SharedCloudWebView2Environment.cs) so
        a sign-in on either surface is shared with the other.

        Same failure-panel pattern as MacroCodesWindow.xaml (WebView2
        Runtime missing/init failure never crashes the app), plus a Retry
        button — worth letting staff retry without restarting the app.
    -->
    <Grid>
        <wv2:WebView2 x:Name="WebView"/>

        <!--
            TIMEOUT FIX (Will, 2026-09-16): shown after ~3s if WebView2
            still hasn't started (see Services/InitWaitPolicy.cs) so a
            slow-but-eventually-successful start doesn't just look like a
            blank/frozen page for up to 45s. Hidden again once
            initialization resolves (success OR failure/timeout, at which
            point FailurePanel takes over).
        -->
        <TextBlock x:Name="InitStatusTextBlock" Text="Starting the embedded browser…"
                   Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="13" Foreground="Gray"/>

        <StackPanel x:Name="FailurePanel" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
            <TextBlock Text="Couldn't load this page." FontWeight="Bold" FontSize="14"
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center">
                This usually means the WebView2 Runtime isn't installed on this computer. Download it from
                <Hyperlink NavigateUri="https://go.microsoft.com/fwlink/p/?LinkId=2124703"
                           RequestNavigate="DownloadLink_OnRequestNavigate">go.microsoft.com/fwlink/p/?LinkId=2124703</Hyperlink>
                (Evergreen WebView2 Runtime) and try again.
            </TextBlock>
            <TextBlock x:Name="FailureDetailTextBlock" Margin="0,10,0,0" Foreground="Gray"
                       TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" FontSize="11"/>
            <Button Content="Retry" Click="RetryButton_OnClick" Padding="12,4" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
