<Window x:Class="VaccineAssist.Desktop.Views.FaxDuplicateConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine Assist — Possible duplicates"
        Width="520" SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <!--
        V-T65 R6 (Will, verbatim, 2026-09-29): "we should just store the
        administration dates, quantity on each date, and look for
        duplicates that way, then show an alert, allowing them to continue
        and potentially send duplicates, cancel altogether, or only send
        non-duplicates." Shown by FaxSendCoordinator.ConfirmDuplicates
        (wired in MainWindow.xaml.cs) right before a send actually starts,
        whenever FaxRunOrchestrator.Preview found any (date, vaccine)
        pairs already in FaxFileLedger.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="This file may include vaccines already faxed" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="The following date/vaccine combinations already have a sent batch on file:" TextWrapping="Wrap"/>

        <ItemsControl Grid.Row="4" ItemsSource="{Binding DuplicateLines}" MaxHeight="220">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,2,0,2" TextWrapping="Wrap"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="10,4" Click="CancelButton_OnClick"/>
            <Button Content="Send only new rows" Padding="10,4" Margin="8,0,0,0" FontWeight="Bold" Click="SendOnlyNewButton_OnClick"/>
            <Button Content="Send all anyway" Padding="10,4" Margin="8,0,0,0" Click="SendAllButton_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
