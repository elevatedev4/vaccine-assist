<Window x:Class="VaccineAssist.Desktop.Views.FluPreferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferred flu vaccine"
        Width="500" SizeToContent="Height"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Loaded="FluPreferenceWindow_OnLoaded"
        PreviewKeyDown="FluPreferenceWindow_OnPreviewKeyDown">
    <!--
        Testing version "flu-preferred" (Will, 2026-10-18, verbatim): "If
        someone selects NOT the preferred vaccine for the age range, you
        should add a prompt after they select it that alerts them of what
        they selected and the preferred vaccine for the age range, then
        give them two buttons: proceed with X (the recommended vaccine) as
        the highlighted preferred button, or proceed with X (the
        non-preferred option they selected) as the non-preferred option."

        Same shell as AgePromptWindow (no Owner - MainWindow is usually
        hidden to the tray here; Topmost, CenterScreen, no taskbar entry).
        The X button and Esc cancel the whole entry. When the preferred
        product can't be entered (not on file, or no usable lot), the
        reason is shown, only "Proceed with <selected>" and Cancel remain.
    -->
    <StackPanel Margin="18">
        <TextBlock x:Name="SelectedTextBlock" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock x:Name="AgeTextBlock" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="PreferredTextBlock" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock x:Name="ApprovedNoteTextBlock" Margin="0,10,0,0" Foreground="#B45309" FontWeight="SemiBold"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="UnavailableTextBlock" Margin="0,10,0,0" Foreground="#B91C1C" FontWeight="SemiBold"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <!-- Highlighted default: the recommended product. -->
            <Button x:Name="PreferredButton" Padding="14,7" Margin="0,0,8,0"
                    IsDefault="True" FontWeight="Bold" Foreground="White"
                    Background="#1F6FEB" BorderBrush="#0D3C78"
                    Click="PreferredButton_OnClick"/>
            <!-- Secondary: what they selected. -->
            <Button x:Name="SelectedButton" Padding="14,7" Click="SelectedButton_OnClick"/>
            <Button x:Name="CancelButton" Content="Cancel" Padding="14,7" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="CancelButton_OnClick"/>
        </StackPanel>
    </StackPanel>
</Window>
