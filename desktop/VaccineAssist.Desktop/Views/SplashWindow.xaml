<Window x:Class="VaccineAssist.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine Assist"
        Width="260" Height="110"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
    <!--
        Will, 2026-09-13 (verbatim): "The login screen is still showing
        momentarily and then disappearing without me needing to do
        anything ... don't let it flash the way it is now." App.xaml.cs's
        StartSignInFlowAsync shows this instead of LoginWindow whenever
        there's a stored credential worth trying silently (a not-yet-
        expired session.json or a seeded autologin.json) — a tiny,
        borderless, non-taskbar window with no form fields, so there's
        nothing to flash even if the silent sign-in takes a moment. Closed
        the instant that attempt finishes, whether it succeeds (straight
        into MainWindow) or fails (falls back to the real LoginWindow).
    -->
    <Border BorderBrush="#D9D9D9" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Vaccine Assist" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Signing in…" FontSize="12" Foreground="Gray" Margin="0,8,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
