<UserControl x:Class="VaccineAssist.Desktop.Views.LotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="LotsView_OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Lots — inventory and expirations" FontSize="18" FontWeight="Bold"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Refresh" Command="{Binding LoadCommand}" Padding="8,2"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Padding="8">
            <StackPanel>
                <TextBlock Text="Add a lot" FontWeight="Bold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding Vaccines}" DisplayMemberPath="Name"
                              SelectedItem="{Binding NewLotVaccine}"/>
                    <TextBox Grid.Column="2" Text="{Binding NewLotNumber, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Lot number"/>
                    <DatePicker Grid.Column="4" SelectedDate="{Binding NewLotExpiration}"/>
                    <TextBox Grid.Column="6" Text="{Binding NewLotNote, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Note (optional)"/>
                    <Button Grid.Column="8" Content="Add lot" Command="{Binding AddLotCommand}" Padding="8,2"/>
                </Grid>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="6" ItemsSource="{Binding Lots}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lot number" Binding="{Binding LotNumber}" Width="*"/>
                <DataGridTextColumn Header="Expiration" Binding="{Binding Expiration}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <!-- Mode=OneWay is required here: DataGridCheckBoxColumn always
                     renders its cell with a live CheckBox, and CheckBox.IsChecked
                     defaults to a TwoWay binding mode regardless of the grid's
                     IsReadOnly="True" above. Since IsExpired (Models/Lot.cs) is
                     a get-only computed property, WPF throws
                     InvalidOperationException while generating the cell unless
                     the mode is pinned to OneWay. -->
                <DataGridCheckBoxColumn Header="Expired" Binding="{Binding IsExpired, Mode=OneWay}" Width="0.5*"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
