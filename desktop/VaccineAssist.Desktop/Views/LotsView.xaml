<UserControl x:Class="VaccineAssist.Desktop.Views.LotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="LotsView_OnLoaded">
    <UserControl.Resources>
        <!-- V-T21 item 4: shared between the active grid (Grid.Row="6")
             and the collapsed inactive Expander's grid below — WPF has no
             simple way to share a DataGrid.Columns collection between two
             DataGrids, so those are duplicated below, but the row-highlight
             style is a plain resource both grids reference. -->
        <Style x:Key="LotsRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                    <Setter Property="Background" Value="#FFCDD2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPastBeyondUseDate}" Value="True">
                    <Setter Property="Background" Value="#FFCDD2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Lots — inventory and expirations" FontSize="18" FontWeight="Bold"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Refresh" Command="{Binding LoadCommand}" Padding="8,2"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Padding="8">
            <StackPanel>
                <TextBlock Text="Add a lot" FontWeight="Bold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding Vaccines}" DisplayMemberPath="Name"
                              SelectedItem="{Binding NewLotVaccine}"/>
                    <TextBox Grid.Column="2" Text="{Binding NewLotNumber, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Lot number"/>
                    <DatePicker Grid.Column="4" SelectedDate="{Binding NewLotExpiration}"/>
                    <TextBox Grid.Column="6" Text="{Binding NewLotNote, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Note (optional)"/>
                    <Button Grid.Column="8" Content="Add lot" Command="{Binding AddLotCommand}" Padding="8,2"/>
                </Grid>
            </StackPanel>
        </Border>

        <!--
            MSG893 item 4: editable, autosaving table. IsReadOnly="False"
            at the grid level; Vaccine/NDC/Status stay IsReadOnly="True"
            per-column (joined/computed display fields, not part of this
            item's editable-fields ask) — only Lot number/Expiration/
            Beyond-use date/Note are genuinely editable. Each editable
            column commits on cell-edit-end straight into
            LotRowViewModel's matching property setter, which autosaves
            (see that class's own doc comment) — no explicit "Save"
            button/command needed here. No separate "Expired" column
            (unlike the pre-item-4 grid) — the row highlight below covers
            that, per the brief's own column list.

            RowStyle below implements "row highlights if expired or
            beyond-use date is met, clears automatically once the date is
            edited to a future date" — LotRowViewModel.Expiration/
            BeyondUseDate raise IsExpired/IsPastBeyondUseDate's own
            PropertyChanged on every edit, so these DataTriggers react
            live without any extra plumbing.
        -->
        <DataGrid Grid.Row="6" ItemsSource="{Binding ActiveLots}" AutoGenerateColumns="False"
                  IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  RowStyle="{StaticResource LotsRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Vaccine" Binding="{Binding VaccineName}" Width="1.5*" IsReadOnly="True"/>
                <DataGridTextColumn Header="NDC" Binding="{Binding VaccineNdc}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Lot number" Binding="{Binding LotNumber, UpdateSourceTrigger=LostFocus}" Width="*"/>
                <!-- DatePicker template columns rather than plain text —
                     matches the DatePicker already used elsewhere in this
                     app (Add-lot form below, the data-entry popup's
                     expiration gate) for date entry, and avoids ambiguous
                     free-text date parsing in a DataGrid cell.

                     REVIEWER FIX (Minor): Expiration binds to
                     LotRowViewModel.Expiration, a non-nullable DateTime
                     (a lot's expiration is required — unlike Beyond-use
                     date below, which stays nullable on purpose). WPF's
                     default binding conversion can't push a cleared
                     (null) SelectedDate into a non-nullable DateTime
                     property, and by default fails that SILENTLY — no
                     revert, no autosave, no visible feedback. The
                     SelectedDateChanged handler below is this DatePicker's
                     own explicit guard against exactly that: see
                     LotsView.xaml.cs. -->
                <DataGridTemplateColumn Header="Expiration" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding Expiration, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedDateChanged="ExpirationDatePicker_OnSelectedDateChanged"
                                        BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Beyond-use date" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding BeyondUseDate, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.6*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" Width="1.5*"/>
                <!-- Save failures must not be silent (brief requirement):
                     shows LotRowViewModel.SaveError inline, per row, in
                     red — empty/collapsed whenever the row's last save (or
                     load) was fine. -->
                <DataGridTextColumn Header="Save status" Binding="{Binding SaveError}" Width="1.2*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- V-T21 item 4 (Will, 2026-09-08): inactive vaccines' lots get
             their own collapsed section below the active grid above,
             IsExpanded="False" by default — the header text updates live
             off InactiveLots.Count since ObservableCollection raises
             PropertyChanged for Count on every Clear()/Add(). Same columns
             as the active grid (WPF doesn't share a DataGrid.Columns
             collection between two grids), so lot/expiration/BUD/note stay
             editable here too — an inactive vaccine can still get its lot
             data fixed up without needing to reactivate it first. -->
        <Expander Grid.Row="8" IsExpanded="False"
                  Header="{Binding InactiveLots.Count, StringFormat='Inactive vaccines ({0})'}">
            <DataGrid ItemsSource="{Binding InactiveLots}" AutoGenerateColumns="False"
                      IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      RowStyle="{StaticResource LotsRowStyle}" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vaccine" Binding="{Binding VaccineName}" Width="1.5*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="NDC" Binding="{Binding VaccineNdc}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Lot number" Binding="{Binding LotNumber, UpdateSourceTrigger=LostFocus}" Width="*"/>
                    <DataGridTemplateColumn Header="Expiration" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Expiration, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateChanged="ExpirationDatePicker_OnSelectedDateChanged"
                                            BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Beyond-use date" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding BeyondUseDate, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.6*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" Width="1.5*"/>
                    <DataGridTextColumn Header="Save status" Binding="{Binding SaveError}" Width="1.2*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Red"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>
    </Grid>
</UserControl>
