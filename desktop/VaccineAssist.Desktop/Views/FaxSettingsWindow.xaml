<Window x:Class="VaccineAssist.Desktop.Views.FaxSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine Assist — Fax settings"
        Width="720" Height="720"
        WindowStartupLocation="CenterScreen">
    <!--
        V-T65 (Will's brief, verbatim, 2026-09-29): "Everything else should
        save as it is typed ... very unintuitive to have a hidden save
        button where you have to scroll all the way to the bottom." Every
        field below EXCEPT the provider credentials auto-saves (see
        ViewModels/FaxSettingsViewModel.cs's AutoSaveFieldsAsync,
        debounced ~300ms) — there is no bottom Save button anymore. The
        credentials group (SRFax access id/password, Notifyre API token —
        both PasswordBox-backed, read from code-behind, so they can't
        auto-save the way a plain bound TextBox can) keeps its OWN
        explicit Save button right below the key box, alongside Test
        connection and (Notifyre only) Forget key — same pattern as
        LoginWindow's PasswordInput (PasswordBox.Password isn't bindable).
        No prescriber-fax table and no input-folder/daily-run section
        anymore — the report's own Primary Care Prescriber Fax column is
        the only fax-number source, and sending is a direct one-shot tray
        action (see MainWindow.xaml.cs's ImportReportFileAndSendAsync).
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="Vaccine → PCP fax settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>

            <!-- Always-visible auto-save feedback (Will's brief: "Show a
                 small 'Saved' hint that appears briefly after an
                 auto-save") — placed right under the title, not buried at
                 the bottom, so it's never scrolled out of view. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Saved" Foreground="Green" FontStyle="Italic"
                           Visibility="{Binding IsSavedHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding AutoSaveErrorMessage}" Foreground="Red" Margin="10,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Fax account" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Provider" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                  MinHeight="26" Padding="4,2" HorizontalAlignment="Left" MinWidth="160"/>
                    </Grid>

                    <Grid Visibility="{Binding IsNotifyreSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--
                            Notifyre-key-visibility follow-up (Will,
                            2026-09-28): the box always starts BLANK (never
                            shows the saved token — see FaxSettingsViewModel/
                            FaxSettingsWindow.xaml.cs) with a "paste a new
                            key to replace" hint instead of a real
                            placeholder (PasswordBox has no native
                            watermark). "Forget key" only enables once a
                            key is actually stored.
                        -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API token" VerticalAlignment="Center"/>
                        <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="ApiTokenBox" MinHeight="26" Padding="4,2"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Forget key" Click="ForgetKeyButton_OnClick"
                                Padding="8,2" Margin="6,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NotifyreKeyStatusText}" FontStyle="Italic" Foreground="DarkSlateGray" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Visibility="{Binding IsSrFaxSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Access ID" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AccessId, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Access password" VerticalAlignment="Center"/>
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="AccessPasswordBox" MinHeight="26" Padding="4,2"/>
                    </Grid>

                    <!-- V-T65: the explicit Save button lives HERE, directly
                         under the key box, next to Test connection — the
                         only field group on this window that doesn't
                         auto-save (see class doc comment). -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save" Click="SaveCredentialsButton_OnClick" Padding="8,2"/>
                        <Button Content="Test connection" Click="TestConnectionButton_OnClick" Padding="8,2" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="Green" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Pharmacy identity" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pharmacy name" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PharmacyName, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>

                        <!-- Fax-report-layout brief (2026-09-28): the
                             letter's pharmacy block needs an address, not
                             just name/phone/fax. -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Address line 1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PharmacyAddressLine1, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="City, ST ZIP" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PharmacyCityStateZip, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Phone" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PharmacyPhone, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Fax (caller ID)" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding PharmacyFax, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Sender email" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SenderEmail, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Account code (optional)" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding AccountCode, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Signature name" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding SignatureName, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="4,2"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Report column map — type the report's actual header for each field" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding ColumnMap}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Field}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Required" Binding="{Binding Required}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Report column header" Binding="{Binding Header, UpdateSourceTrigger=LostFocus}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
