<Window x:Class="VaccineAssist.Desktop.Views.DataEntryPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccine data entry"
        Width="380" SizeToContent="Height"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Loaded="DataEntryPopupWindow_OnLoaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vaccine data entry" FontSize="16" FontWeight="Bold"/>

        <TextBlock Grid.Row="2" Text="Vaccine"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding Vaccines}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedVaccine}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Patient age (years)" VerticalAlignment="Center"/>
            <TextBox Text="{Binding PatientAgeYears, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0,16,0"/>
            <TextBlock Text="Admin site" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding AdminSiteOptions}" SelectedItem="{Binding AdminSite}" Width="90" Margin="8,0,0,0"/>
        </StackPanel>

        <Button Grid.Row="6" Content="Validate" Command="{Binding ValidateCommand}" Padding="8,2" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="8">
            <TextBlock Text="{Binding Gate.BlockMessage}" Foreground="Red" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding EligibilityResult.Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="DarkOrange" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <CheckBox Grid.Row="10" Content="Dry run (log steps, don't touch PioneerRx)" IsChecked="{Binding IsDryRun}"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal">
            <Button Content="Enter into Pioneer" Command="{Binding EnterIntoPioneerCommand}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="Copy to clipboard" Command="{Binding CopyToClipboardCommand}" Padding="8,2"/>
        </StackPanel>

        <TextBlock Grid.Row="14" Text="Step log" FontWeight="Bold"/>
        <ListBox Grid.Row="16" ItemsSource="{Binding StepLog}" Height="90" FontFamily="Consolas" FontSize="11"/>

        <StackPanel Grid.Row="18">
            <TextBlock Text="{Binding StatusMessage}" Foreground="Green" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
