<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      2026-09-13 (tray icon, Will's brief): only System.Windows.Forms.NotifyIcon
      + ContextMenuStrip are used from WinForms (see Tray/TrayIconController.cs)
      — a standard, supported WPF+WinForms combination, chosen specifically
      to avoid a new third-party NuGet package for the tray icon.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VaccineAssist.Desktop</RootNamespace>
    <AssemblyName>VaccineAssist.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Add <ApplicationIcon>Assets\vaccineassist.ico</ApplicationIcon> once a real icon exists;
         omitted for phase 1 so the project builds as-is. -->

    <!--
      Velopack installer channel (G-Q5, Will 2026-09-29). Suppresses the WPF
      SDK's auto-generated Main() (App.xaml's Build Action stays
      "ApplicationDefinition" so InitializeComponent() is still generated —
      only the paired Main() is suppressed) so Program.cs can provide its
      own, calling VelopackApp.Build().Run() first. See Program.cs's doc
      comment for the full explanation of this — Microsoft's own documented
      mechanism for a custom WPF entry point, not a hack.

      CI FIX (desktop-release build, 2026-09-29): DefineConstants alone
      wasn't enough — the WPF markup compiler's *_wpftmp intermediate
      project still saw two Main() methods (its own generated one plus
      Program.cs's) and failed with CS0017 "Program has more than one
      entry point defined. Compile with /main to specify the type that
      contains the entry point." StartupObject is MSBuild's equivalent of
      that /main compiler flag — it tells the compiler which Main() to
      use as the actual entry point instead of erroring on the ambiguity.
      Both are needed together: DISABLE_XAML_GENERATED_MAIN alone doesn't
      reliably suppress the generated Main in every build (the *_wpftmp
      project apparently doesn't always honor it), so StartupObject is the
      belt-and-suspenders fix that makes the intent unambiguous either way.
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>VaccineAssist.Desktop.Program</StartupObject>
  </PropertyGroup>

  <!--
    Defensive guard for UseWindowsForms above: if the SDK's implicit-usings
    machinery ever globally imports System.Windows.Forms/System.Drawing for
    a UseWindowsForms=true project (it does for the WindowsDesktop "Windows
    Forms" flavor — see Microsoft's project-SDK docs), that would collide
    with every existing file's `using System.Windows;` for unqualified
    types both namespaces define (MessageBox, Application, Clipboard, ...).
    This ItemGroup removes those two implicit usings if they were ever
    added — a no-op otherwise, since every file in this project (including
    the new Tray/TrayIconController.cs) already spells out its own
    `using System.Windows.Forms;`/`using System.Drawing;` explicitly rather
    than relying on an implicit one.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Supabase C# SDK (nuget id "Supabase" — the old "supabase-csharp" id
      is deprecated at 0.16.2). Used narrowly, for auth only: Login screen
      calls Client.Auth.SignIn(email, password) against the shared
      pharmacy login (Supabase.Gotrue), then the resulting access token is
      sent as an Authorization: Bearer header to the cloud app's own REST
      API (Services/VaccineApiService.cs) for actual vaccine/lot/
      eligibility data — see cloud/lib/auth.ts on the other side of that
      call. This app does not use the SDK's Postgrest/Realtime/Storage
      pieces; the cloud app is the only thing that talks to Postgres
      directly.
    -->
    <PackageReference Include="Supabase" Version="1.6.0" />

    <!--
      FlaUI wraps UIA2/UIA3 COM interop with a much friendlier, testable
      API than raw System.Windows.Automation. Same package + version as
      rx-verify's overlay/RxVerifyOverlay.csproj (already proven to
      restore/build in this environment) — used here for the vaccine
      data-entry mode's PioneerRx window attach + (once wired) field
      automation. See Uia/ and PioneerEntryAutomation/Sequencing/.
    -->
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />

    <!--
      2026-09-13: Ctrl+8 macro-codes popup (MacroCodesWindow) hosts the
      cloud app's /macro-codes?embed=1 page in-process via WebView2 rather
      than shelling out to the user's default browser — lets it stay a
      borderless Topmost popup and round-trip window.chrome.webview.postMessage
      calls back into this app (see MacroCodesWindow.xaml.cs). Requires the
      Evergreen WebView2 Runtime on the workstation, which ships by default
      on Windows 10/11 — no separate install expected in the field.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />

    <!--
      2026-09-13 (90-day sign-in, Will's brief): DPAPI-encrypts the
      persisted Supabase refresh token at rest (Settings/SessionStore.cs)
      — CurrentUser-scoped, decryptable only by the same Windows account
      on the same machine, no separate secret of our own to manage. Not
      part of the base net8.0-windows shared framework; explicitly asked
      for in the brief by name.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="5.0.0" />

    <!--
      V-T53 (vaccine -> PCP fax, Will's brief): report import (CSV/XLSX)
      and per-patient PDF generation. All three are MIT-licensed —
      CsvHelper (github.com/JoshClose/CsvHelper) and ClosedXML
      (github.com/ClosedXML/ClosedXML) for the two report formats
      ReportImporter accepts; PDFsharp-WPF (github.com/empira/PDFsharp,
      the WPF-flavored build — this project already has UseWPF=true, and
      the WPF/GDI builds resolve standard fonts like Arial straight from
      the OS with no custom IFontResolver needed, unlike the fully
      cross-platform "PDFsharp" Core package) for
      Fax/VaccineRecordPdfBuilder.cs.
    -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />

    <!--
      Velopack installer channel (G-Q5, Will 2026-09-29: real Setup.exe +
      self-update as an ADDITIONAL channel alongside the existing
      update-and-run.ps1 + shortcut flow, which must keep working exactly
      as today — see Velopack/VelopackUpdater.cs's gate on
      UpdateManager.IsInstalled for how that's enforced). Version pinned to
      the newest stable release on nuget.org as of 2026-09-29 (checked live
      against api.nuget.org — the installer plan's "0.x" assumption is out
      of date; Velopack has been on a 1.x/2.x-track versioning scheme for a
      while).
    -->
    <PackageReference Include="Velopack" Version="1.2.161" />

    <!--
      Velopack's own NuGet package has NO client-side S3 update source
      (verified against github.com/velopack/velopack tag 1.2.161 —
      Sources/ only ships GithubSource/GitlabSource/GiteaSource/
      SimpleWebSource/SimpleFileSource/VelopackFlowSource; S3 support is
      CLI-only, for `vpk upload/download s3`, i.e. for PUSHING a release,
      not for an app to pull one). Velopack/S3UpdateSource.cs implements
      the missing client-side half directly against S3 using this SDK,
      for the private-bucket + embedded-read-only-key design Will approved
      (G-Q5).
    -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Read-only S3 credentials for update checks — see
      Velopack/release-source.example.json (committed, placeholders only)
      and this repo's .gitignore. The SDK's default item globs already pick
      this file up as a "None" item when it exists (it's just another file
      under the project directory) — this only ADDS the copy-to-output
      metadata to that existing item (via Update=, not Include=, so there's
      no duplicate-item conflict with the implicit glob). Condition="Exists(...)"
      means a checkout without this file (every checkout except a
      workstation Will has deliberately configured) builds exactly as
      before — VelopackUpdater logs once and skips update checks entirely
      when it's missing (see ReleaseSourceConfig.Load).
    -->
    <None Update="Velopack\release-source.json" Condition="Exists('Velopack\release-source.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
