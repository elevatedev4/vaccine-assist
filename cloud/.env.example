# Vaccine Assist — cloud (Next.js) environment variables
# Copy to .env.local for local dev. NEVER commit the filled-in file.
# The Supabase project for this app does not exist yet (Phase 1 scaffold) —
# these are placeholders only; nothing in this codebase makes a live call
# with them until a real project is provisioned.

# --- Supabase ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Public anon key (safe for the desktop app / browser)
SUPABASE_ANON_KEY=
# Service-role key — server-only, never sent to the desktop app or browser
SUPABASE_SERVICE_ROLE_KEY=
# Same two values, exposed to the client bundle for the future reporting UI
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Acuity Scheduling (appointment-count polling) ---
# Preferred: leave these blank and set the User ID/API key from the app
# itself at /settings (stored in the acuity_credentials table — see
# supabase/migrations/0002_acuity_credentials.sql). These env vars are
# now only a fallback, used if that table has no row yet.
ACUITY_USER_ID=
ACUITY_API_KEY=
# Seconds to cache polled Acuity results before re-fetching (see
# app/api/acuity/poll/route.ts) — stubbed at 300s (5 min) per the phase-1 plan.
ACUITY_POLL_CACHE_SECONDS=300

# --- SES inbound webhook (app/api/webhooks/ses/route.ts) ---
# Shared secret used to validate the inbound SES/SNS notification before
# any processing. Sent as the `x-ses-webhook-secret` header by the
# legacy/manual contract, or as a `?secret=` query param baked into the
# subscribed URL for real SNS HTTPS posts (SNS can't send custom headers).
SES_WEBHOOK_SECRET=
# SNS topic ARN that inbound SubscriptionConfirmation/Notification posts
# must carry (arn:aws:sns:<region>:<account-id>:<topic-name>). Leave
# blank until the SNS topic is created (bootstrapping — see route.ts doc
# comment); the route logs a warning every time it accepts SNS traffic
# without this check. Set it once the topic exists to lock the route
# down to that exact topic.
SES_SNS_TOPIC_ARN=

# --- SES outbound email (lib/email.ts) ---
# Same AWS SES setup as ~/claude/elevate / ~/claude/clarify. Nothing in
# this app sends email yet (V-T3 item 5 added the helper only, ready for
# a future feature — e.g. Ordering tab confirmations) — these are unused
# until something calls sendEmail().
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM=noreply@orchardsdrug.com

# --- App ---
# Single shared pharmacy login (Supabase Auth, email/password) used by both
# the desktop app and this cloud app. No per-staff accounts in phase 1.
VACCINE_ASSIST_SHARED_LOGIN_EMAIL=
